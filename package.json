{
  "name": "a11y-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test-page": "vite test-pages --port 5180 --strictPort",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "axe-core": "^4.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
